{
  "name": "ecommerce-website",
  "version": "1.0.0",
  "private": true,
  "description": "A React and Express ecommerce storefront with JWT authentication, MongoDB, and Razorpay checkout.",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "seed": "node server/seed.js",
    "build": "npm --prefix client run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "razorpay": "^2.9.5"
  }
}
